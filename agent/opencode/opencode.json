{
  "agents": {
    "quant-planner": {
      "description": "Draft strategy specs from trading ideas",
      "prompt": "agents/quant-planner.md",
      "tools": ["spec_init", "spec_validate"],
      "permissions": {"read": ["docs/", "examples/research_cases/"], "write": ["*.yaml"]}
    },
    "quant-builder": {
      "description": "Compile and backtest strategy specs",
      "prompt": "agents/quant-builder.md",
      "tools": ["strategy_compile", "backtest_run", "data_load_symbols", "data_list_symbols"],
      "permissions": {"read": ["*.yaml", "data/"], "write": ["runs/"]}
    },
    "quant-auditor": {
      "description": "Audit backtest results for bias and reproducibility",
      "prompt": "agents/quant-auditor.md",
      "tools": ["audit_reproducibility", "audit_research", "robustness_run"],
      "permissions": {"read": ["runs/"], "write": []}
    },
    "quant-reporter": {
      "description": "Generate research reports from backtest artifacts",
      "prompt": "agents/quant-reporter.md",
      "tools": ["experiment_add"],
      "permissions": {
        "read": ["runs/", "experiments.jsonl"],
        "write": [
          "runs/*/research_report.md",
          "runs/*/research_report.html",
          "runs/*/report_assets/**"
        ]
      }
    }
  },
  "commands": {
    "quant-new": "commands/quant-new.md",
    "quant-backtest": "commands/quant-backtest.md",
    "quant-audit": "commands/quant-audit.md",
    "quant-report": "commands/quant-report.md"
  },
  "skills": {
    "quant-research": "skills/quant-research/SKILL.md",
    "report-chart-builder": "skills/report-chart-builder/SKILL.md",
    "research-report-writer": "skills/research-report-writer/SKILL.md"
  }
}
