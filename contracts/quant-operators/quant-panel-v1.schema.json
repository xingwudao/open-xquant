{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-xquant.dev/contracts/quant-operators/quant-panel-v1.schema.json",
  "title": "QuantPanel v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "primary_key", "columns", "context", "alignment", "records"],
  "properties": {
    "schema_version": { "const": 1 },
    "primary_key": {
      "type": "array",
      "minItems": 2,
      "prefixItems": [{ "const": "date" }, { "const": "code" }],
      "items": false
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "dtype", "required"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "dtype": { "enum": ["boolean", "int64", "float64", "string", "date", "datetime"] },
          "required": { "type": "boolean" }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timezone", "calendar", "frequency", "timestamp_semantics", "currency", "price_adjustment", "data_version", "source"],
      "properties": {
        "timezone": { "type": "string", "minLength": 1 },
        "calendar": { "type": "string", "minLength": 1 },
        "frequency": { "type": "string", "minLength": 1 },
        "timestamp_semantics": { "enum": ["session_date", "bar_open", "bar_close", "event_time", "publication_time"] },
        "currency": { "type": "string", "minLength": 1 },
        "price_adjustment": { "enum": ["raw", "forward_adjusted", "backward_adjusted", "total_return_adjusted"] },
        "data_version": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "alignment": { "enum": ["preserve_input_order", "canonical_order", "explicit_keyed_output"] },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "code"],
        "properties": {
          "date": { "type": "string", "minLength": 1 },
          "code": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    }
  }
}
