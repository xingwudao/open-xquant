{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-xquant.org/contracts/quant-operators/operator-manifest-v1.schema.json",
  "title": "open-xquant Operator Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {"execution_scope": {"const": "cross_section"}},
        "required": ["execution_scope"]
      },
      "then": {
        "properties": {
          "inputs": {
            "properties": {"min_history": {"const": 1}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"lifecycle": {"const": "fit_transform"}},
        "required": ["lifecycle"]
      },
      "then": {
        "required": ["ml"],
        "properties": {
          "ml": {
            "required": ["usable_as_feature", "requires_fit", "fit_scope", "state_serializable"],
            "properties": {
              "usable_as_feature": {"const": true},
              "requires_fit": {"const": true},
              "fit_scope": {"const": "training_window_only"},
              "state_serializable": {"const": true}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"lifecycle": {"not": {"const": "fit_transform"}}},
        "required": ["lifecycle"]
      },
      "then": {
        "not": {"required": ["fitted_state"]},
        "properties": {
          "ml": {
            "properties": {"requires_fit": {"const": false}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"execution_scope": {"const": "time_series"}},
        "required": ["execution_scope"]
      },
      "then": {
        "properties": {
          "inputs": {
            "properties": {"min_assets": {"const": 1}}
          }
        }
      }
    }
  ],
  "required": [
    "schema_version",
    "operator_id",
    "operator_version",
    "semantic_name",
    "distribution",
    "module",
    "callable",
    "execution_scope",
    "lifecycle",
    "causality",
    "availability",
    "inputs",
    "parameters",
    "outputs"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "operator_id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?)+$"
    },
    "operator_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "semantic_name": {"type": "string", "minLength": 1},
    "distribution": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "module": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"
    },
    "callable": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
    "execution_scope": {
      "enum": ["time_series", "cross_section", "panel", "research_only"]
    },
    "lifecycle": {
      "enum": ["stateless", "fit_transform", "evaluation", "data_access", "visualization"]
    },
    "causality": {"enum": ["past_only", "label_dependent", "future_using"]},
    "availability": {"$ref": "#/$defs/availability"},
    "inputs": {"$ref": "#/$defs/inputs"},
    "parameters": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/parameter"}
    },
    "outputs": {"$ref": "#/$defs/outputs"},
    "fitted_state": {"$ref": "#/$defs/fittedState"},
    "semantics": {"$ref": "#/$defs/semantics"},
    "ml": {"$ref": "#/$defs/ml"},
    "determinism": {"$ref": "#/$defs/determinism"},
    "manifest_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": {
          "enum": ["pre_open_t", "open_t", "intraday_t", "close_t", "after_close_t", "publication_time"]
        },
        "derivation": {"type": "string", "minLength": 1}
      }
    },
    "missingValuePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["propagate", "skip_window", "require_complete", "explicit_fill"]},
        "value": {},
        "method": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "explicit_fill"}}},
          "then": {"anyOf": [{"required": ["value"]}, {"required": ["method"]}]}
        }
      ]
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_columns",
        "optional_columns",
        "dtypes",
        "min_assets",
        "min_history",
        "requires_complete_cross_section",
        "requires_benchmark",
        "requires_industry",
        "requires_market_cap",
        "requires_fundamentals",
        "requires_sorted",
        "mutates_input",
        "missing_value_policy"
      ],
      "properties": {
        "required_columns": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "optional_columns": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "dtypes": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "min_assets": {"type": "integer", "minimum": 1},
        "min_history": {"type": "integer", "minimum": 0},
        "requires_complete_cross_section": {"type": "boolean"},
        "requires_benchmark": {"type": "boolean"},
        "requires_industry": {"type": "boolean"},
        "requires_market_cap": {"type": "boolean"},
        "requires_fundamentals": {"type": "boolean"},
        "requires_sorted": {"type": "boolean"},
        "mutates_input": {"const": false},
        "missing_value_policy": {"$ref": "#/$defs/missingValuePolicy"}
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "required",
        "unit",
        "affects_warmup",
        "affects_output_fields",
        "affects_causality",
        "affects_availability"
      ],
      "properties": {
        "type": {"enum": ["integer", "number", "string", "boolean", "array", "object"]},
        "default": {},
        "required": {"type": "boolean"},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "enum": {"type": "array", "minItems": 1, "uniqueItems": true},
        "unit": {"type": ["string", "null"]},
        "affects_warmup": {"type": "boolean"},
        "affects_output_fields": {"type": "boolean"},
        "affects_causality": {"type": "boolean"},
        "affects_availability": {"type": "boolean"}
      }
    },
    "outputField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name_template", "dtype"],
      "properties": {
        "name_template": {"type": "string", "minLength": 1},
        "dtype": {"type": "string", "minLength": 1},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"}
      }
    },
    "warmup": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "rows"],
          "properties": {
            "kind": {"const": "fixed"},
            "rows": {"type": "integer", "minimum": 0}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "parameter"],
          "properties": {
            "kind": {"const": "parameter"},
            "parameter": {"type": "string", "minLength": 1},
            "offset": {"type": "integer", "default": 0}
          }
        }
      ]
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "alignment", "warmup", "nan_policy", "multiple"],
      "properties": {
        "fields": {"type": "array", "items": {"$ref": "#/$defs/outputField"}, "minItems": 1},
        "alignment": {"enum": ["preserve_input_order", "canonical_order", "explicit_keyed_output"]},
        "warmup": {"$ref": "#/$defs/warmup"},
        "nan_policy": {"enum": ["warmup_only", "propagate", "declared_missing", "none"]},
        "multiple": {"type": "boolean"}
      }
    },
    "fittedState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serializable", "format"],
      "properties": {
        "serializable": {"const": true},
        "format": {"type": "string", "minLength": 1},
        "fit_scope": {"type": "string", "minLength": 1}
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zh_name": {"type": "string"},
        "en_name": {"type": "string"},
        "formula": {"type": "string"},
        "category": {"type": "string"},
        "description": {"type": "string"},
        "recommended_use": {"type": "array", "items": {"type": "string"}},
        "common_misuse": {"type": "array", "items": {"type": "string"}},
        "markets": {"type": "array", "items": {"type": "string"}}
      }
    },
    "ml": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "usable_as_feature": {"type": "boolean"},
        "usable_as_label": {"type": "boolean"},
        "feature_availability": {"type": "string"},
        "requires_fit": {"type": "boolean"},
        "fit_scope": {"type": "string"},
        "state_serializable": {"type": "boolean"},
        "normalization_required": {"type": "boolean"},
        "expected_stationarity": {"type": "string"}
      }
    },
    "determinism": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bitwise": {"type": "boolean"},
        "absolute_tolerance": {"type": "number", "minimum": 0},
        "relative_tolerance": {"type": "number", "minimum": 0},
        "tested_platforms": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
