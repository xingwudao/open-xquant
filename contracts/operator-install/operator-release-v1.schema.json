{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-xquant.dev/contracts/operator-install/operator-release-v1.schema.json",
  "title": "Operator release v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_type",
    "provider",
    "release",
    "submission_commit",
    "source_commit",
    "certification_state",
    "targets",
    "operator_count"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "release_type": { "const": "open-xquant-operator-release" },
    "provider": { "$ref": "#/$defs/provider" },
    "release": { "$ref": "#/$defs/semver" },
    "submission_commit": { "$ref": "#/$defs/commit" },
    "source_commit": { "$ref": "#/$defs/commit" },
    "certification_state": { "const": "research-certified" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/target" }
    },
    "operator_count": { "type": "integer", "minimum": 1, "maximum": 1024 }
  },
  "$defs": {
    "provider": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*)|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:(?:0|[1-9][0-9]*)|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "pythonPackageVersion": {
      "allOf": [
        {
          "type": "string",
          "pattern": "^(?:[0-9]+!)?[0-9]+(?:\\.[0-9]+)*(?:(?:a|b|rc)[0-9]+)?(?:\\.post[0-9]+)?(?:\\.dev[0-9]+)?(?:\\+[a-z0-9]+(?:[._-][a-z0-9]+)*)?$"
        },
        { "not": { "pattern": "[\\r\\n]" } }
      ]
    },
    "commit": {
      "type": "string",
      "pattern": "^git-sha1:[0-9a-f]{40}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "url", "size_bytes", "digest"],
      "properties": {
        "filename": {
          "type": "string",
          "pattern": "^[^/\\\\\\u0000]+$"
        },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 67108864 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "wheel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "url",
        "size_bytes",
        "digest",
        "distribution",
        "version",
        "role",
        "tags"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "pattern": "^[^/\\\\\\u0000]+\\.whl$"
        },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 67108864 },
        "digest": { "$ref": "#/$defs/digest" },
        "distribution": { "$ref": "#/$defs/provider" },
        "version": { "$ref": "#/$defs/pythonPackageVersion" },
        "role": { "enum": ["implementation", "runtime-dependency"] },
        "tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.]+-[A-Za-z0-9_.]+-[A-Za-z0-9_.]+$"
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python_tag", "abi_tag", "platform_tag", "bundle", "wheels"],
      "properties": {
        "python_tag": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "abi_tag": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "platform_tag": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "bundle": { "$ref": "#/$defs/asset" },
        "wheels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/wheel" },
          "contains": {
            "type": "object",
            "required": ["role"],
            "properties": { "role": { "const": "implementation" } }
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    }
  }
}
