{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-xquant.dev/contracts/operator-certification/provider-catalog-v1.schema.json",
  "title": "Operator provider catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider", "contract_version", "status", "build_record", "operators"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "release"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
        "release": {"$ref": "#/$defs/semanticVersion"}
      }
    },
    "contract_version": {"$ref": "#/$defs/semanticVersion"},
    "status": {"const": "candidate"},
    "build_record": {"$ref": "#/$defs/relativePath"},
    "operators": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operator_id", "operator_version", "manifest", "baseline"],
        "properties": {
          "operator_id": {"$ref": "#/$defs/operatorId"},
          "operator_version": {"$ref": "#/$defs/semanticVersion"},
          "manifest": {"$ref": "#/$defs/relativePath"},
          "baseline": {"$ref": "#/$defs/relativePath"}
        }
      }
    }
  },
  "$defs": {
    "semanticVersion": {
      "allOf": [
        {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*)|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:(?:0|[1-9][0-9]*)|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
        {"not": {"pattern": "[\\r\\n]"}}
      ]
    },
    "operatorId": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)+$"},
    "relativePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))[^/]+(?:/[^/]+)*$"}
  }
}
