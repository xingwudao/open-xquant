{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-xquant.dev/contracts/operator-certification/numerical-baseline-v1.schema.json",
  "title": "Operator numerical baseline v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider", "release", "cases"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "provider": {"$ref": "#/$defs/provider"},
    "release": {"$ref": "#/$defs/semanticVersion"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operator_id", "operator_version", "parameters", "input", "expected", "tolerance"],
        "properties": {
          "operator_id": {"$ref": "#/$defs/operatorId"},
          "operator_version": {"$ref": "#/$defs/semanticVersion"},
          "parameters": {"type": "object", "additionalProperties": true},
          "input": {"$ref": "#/$defs/quantPanel"},
          "expected": {"type": "object", "minProperties": 1, "maxProperties": 1, "additionalProperties": {"type": "array", "items": {}}},
          "tolerance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["absolute", "relative"],
            "properties": {
              "absolute": {"type": "number", "minimum": 0},
              "relative": {"type": "number", "minimum": 0}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "provider": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "semanticVersion": {"allOf": [{"type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*)|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:(?:0|[1-9][0-9]*)|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"}, {"not": {"pattern": "[\\r\\n]"}}]},
    "operatorId": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)+$"},
    "quantPanel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "primary_key", "columns", "context", "alignment", "records"],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "primary_key": {"type": "array", "minItems": 2, "prefixItems": [{"const": "date"}, {"const": "code"}], "items": false},
        "columns": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "dtype", "required"], "properties": {"name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "dtype": {"enum": ["boolean", "int64", "float64", "string", "date", "datetime"]}, "required": {"type": "boolean"}}}},
        "context": {"type": "object", "additionalProperties": false, "required": ["timezone", "calendar", "frequency", "timestamp_semantics", "currency", "price_adjustment", "data_version", "source"], "properties": {"timezone": {"type": "string", "minLength": 1}, "calendar": {"type": "string", "minLength": 1}, "frequency": {"type": "string", "minLength": 1}, "timestamp_semantics": {"enum": ["session_date", "bar_open", "bar_close", "event_time", "publication_time"]}, "currency": {"type": "string", "minLength": 1}, "price_adjustment": {"enum": ["raw", "forward_adjusted", "backward_adjusted", "total_return_adjusted"]}, "data_version": {"type": "string", "minLength": 1}, "source": {"type": "string", "minLength": 1}}},
        "alignment": {"enum": ["preserve_input_order", "canonical_order", "explicit_keyed_output"]},
        "records": {"type": "array", "items": {"type": "object", "required": ["date", "code"], "properties": {"date": {"type": "string", "minLength": 1}, "code": {"type": "string", "minLength": 1}}, "additionalProperties": true}}
      }
    }
  }
}
