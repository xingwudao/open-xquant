{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-xquant.dev/contracts/operator-certification/certification-record-v2.schema.json",
  "title": "Operator certification record v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "certifier", "certified_at", "provider", "release", "submission_commit", "source_commit", "state", "target", "artifacts", "baseline_sets", "operators"],
  "properties": {
    "schema_version": {"const": 2}, "certifier": {"const": "open-xquant-local"}, "certified_at": {"type": "string", "format": "date-time"},
    "provider": {"$ref": "#/$defs/provider"}, "release": {"$ref": "#/$defs/semver"}, "submission_commit": {"$ref": "#/$defs/commit"}, "source_commit": {"$ref": "#/$defs/commit"}, "state": {"const": "research-certified"},
    "target": {"$ref": "#/$defs/target"}, "artifacts": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/artifact"}},
    "baseline_sets": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/baselineSet"}},
    "operators": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"$ref": "#/$defs/operator"}}
  },
  "$defs": {
    "provider": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "semver": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*)|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:(?:0|[1-9][0-9]*)|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
    "operatorId": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)+$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "commit": {"type": "string", "pattern": "^git-sha1:[0-9a-f]{40}$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*/$)[^/\\\\]+(?:/[^/\\\\]+)*$"},
    "target": {"type": "object", "additionalProperties": false, "required": ["python_tag", "abi_tag", "platform_tag"], "properties": {"python_tag": {"type": "string", "pattern": "^[a-z0-9_]+$"}, "abi_tag": {"type": "string", "pattern": "^[a-z0-9_]+$"}, "platform_tag": {"type": "string", "pattern": "^[a-z0-9_]+$"}}},
    "pythonPackageVersion": {"allOf": [{"type": "string", "pattern": "^(?:[0-9]+!)?[0-9]+(?:\\.[0-9]+)*(?:(?:a|b|rc)[0-9]+)?(?:\\.post[0-9]+)?(?:\\.dev[0-9]+)?(?:\\+[a-z0-9]+(?:[._-][a-z0-9]+)*)?$"}, {"not": {"pattern": "[\\r\\n]"}}]},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["distribution", "version", "filename", "role", "build_identifier", "digest"], "properties": {"distribution": {"$ref": "#/$defs/provider"}, "version": {"$ref": "#/$defs/pythonPackageVersion"}, "filename": {"type": "string", "pattern": "^[^/\\\\]+\\.whl$"}, "role": {"enum": ["implementation", "runtime-dependency"]}, "build_identifier": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}}},
    "baselineSet": {"type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": {"path": {"$ref": "#/$defs/path"}, "digest": {"$ref": "#/$defs/digest"}}},
    "operator": {"type": "object", "additionalProperties": false, "required": ["operator_id", "operator_version", "manifest_digest", "implementation_digest", "binding_digest", "baseline_cases"], "properties": {"operator_id": {"$ref": "#/$defs/operatorId"}, "operator_version": {"$ref": "#/$defs/semver"}, "manifest_digest": {"$ref": "#/$defs/digest"}, "implementation_digest": {"$ref": "#/$defs/digest"}, "binding_digest": {"$ref": "#/$defs/digest"}, "baseline_cases": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"type": "object", "additionalProperties": false, "required": ["case_id", "status", "baseline_path", "case_index", "case_digest"], "properties": {"case_id": {"type": "string", "minLength": 1}, "status": {"const": "passed"}, "baseline_path": {"$ref": "#/$defs/path"}, "case_index": {"type": "integer", "minimum": 0, "maximum": 1000000}, "case_digest": {"$ref": "#/$defs/digest"}}}}}}
  }
}
